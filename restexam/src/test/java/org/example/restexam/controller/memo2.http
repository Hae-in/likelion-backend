### 메모 생성
POST http://localhost:8080/api2/memos
Content-Type: application/json

{
  "content": "1 memo!!"
}


### id에 해당하는 메모 조회
GET http://localhost:8080/api2/memos/1
Accept: application/json


### 메모 전체 보기
GET http://localhost:8080/api2/memos
Accept: application/json


### 메모 수정
PUT http://localhost:8080/api2/memos/2
Content-Type: application/json

{
    "content": "2 memo!!"
}


### 메모 삭제
DELETE http://localhost:8080/api2/memos/3
Accept: application/json


### id에 해당하는 메모 조회 - xml
GET http://localhost:8080/api2/memos/1
Accept: application/xml


### id에 해당하는 메모 조회 - xml
GET http://localhost:8080/api2/memos/xml/1


### id에 해당하는 메모 조회 - json
GET http://localhost:8080/api2/memos/json/1

